{
  "manifest_version": 3,
  "name": "Agent Tincan History",
  "version": "0.3.1",
  "description": "Lets your Agent Tincan history agent read, and your web agents send to, ChatGPT and claude.ai through your own logged-in browser.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "alarms", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
