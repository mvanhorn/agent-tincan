{
  "mcp": {
    "servers": {
      "agent-tincan": {
        "command": "tincan",
        "args": ["mcp"],
        "env": {
          "TINCAN_CONFIG": "/home/<you>/.config/tincan/openclaw.json"
        }
      }
    }
  },
  "hooks": {
    "enabled": true,
    "token": "<long random hook token; put the same value in wake.json bearer_token>",
    "path": "/hooks",
    "allowedAgentIds": ["main"],
    "allowRequestSessionKey": false
  }
}
